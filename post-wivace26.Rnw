\begin{document}
%
\title{All edges lead to Rome: analyzing Late Antiquity regime shifts using coin hoard data}
%
\titlerunning{All edges lead to Rome}
% If the paper title is too long for the running head, you can set
% an abbreviated paper title here
%
\author{Juan J. Merelo-Guervós\inst{1}\orcidID{0000-0002-1385-9741}}
